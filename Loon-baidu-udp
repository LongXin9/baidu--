/**
 * ==============================================================================
 * 脚本名称：百度/字节系 HTTP & UDP 动态免流 Custom 协议脚本 (带调试日志集成版)
 * 运行平台：Loon (Custom 协议类型)
 * 核心功能：
 *   1. 自动识别 TCP 流量中的字节系/红果短剧域名，动态注入百度高级特征头；
 *   2. 自动识别并为 UDP / QUIC / 游戏流量构建伪装报文，支持免流透传；
 *   3. 集成全链路 console.log 日志，支持在 Loon 日志面板实时排查调试。
 * ==============================================================================
 */

// ==============================================================================
// 一、 握手状态常量定义 (Session State Constants)
// ==============================================================================
const HTTP_STATUS_INVALID = -1;     // 状态：无效/未建立连接
const HTTP_STATUS_CONNECTED = 0;   // 状态：已建立 TCP，已发送请求头
const HTTP_STATUS_WAITRESPONSE = 1; // 状态：等待代理服务器回复 200 OK
const HTTP_STATUS_FORWARDING = 2;   // 状态：握手成功，双向透传中

// 日志前缀常量，便于在 Loon 日志面板筛选
const LOG_PREFIX = "[Baidu-Fake]";

// ==============================================================================
// 二、 目标域名与流量特征规则库 (Match Rules)
// ==============================================================================
const HK_DOMAINS = [
    "zijie", "hongguo", "novel", "pangolin", "sigmob",
    "amemv", "douyin", "iesdouyin", "byteimg",
    "toutiao", "ixigua", "snssdk", "bdurl"
];

const UDP_TARGETS = [
    "udp", "quic", "game", "minecraft", "dota", 
    "lol", "valorant", "genshin"
];

/**
 * 判断是否为红果短剧/字节系目标
 */
function isHongguoTarget(host) {
    if (!host) return false;
    const h = host.toLowerCase();
    return HK_DOMAINS.some(v => h.includes(v));
}

/**
 * 判断是否需要进行 UDP 伪装
 */
function isUdpMasqueradeTarget(host, isUdp) {
    if (!isUdp) return false;
    if (!host) return true;
    const h = host.toLowerCase();
    return UDP_TARGETS.some(v => h.includes(v)) || true;
}

// ==============================================================================
// 三、 Loon Session 生命周期回调函数 (结合日志输出)
// ==============================================================================

/**
 * 生命周期回调 1：TCP 连接建立成功
 */
function tunnelDidConnected() {
    const target = `${$session.conHost}:${$session.conPort}`;
    console.log(`${LOG_PREFIX} ➔ [TCP 连通] 已连接至代理网关，目标地址: ${target}`);
    
    if (!$session.proxy.isTLS) {
        console.log(`${LOG_PREFIX} [明文 HTTP 代理] 开始构建并发送免流请求头...`);
        _writeHttpHeader();
        $session.httpStatus = HTTP_STATUS_CONNECTED;
    } else {
        console.log(`${LOG_PREFIX} [TLS 代理] 底层 TCP 已就绪，等待 TLS 加密握手...`);
    }
    return true;
}

/**
 * 生命周期回调 2：TLS 加密握手成功
 */
function tunnelTLSFinished() {
    const target = `${$session.conHost}:${$session.conPort}`;
    console.log(`${LOG_PREFIX} ➔ [TLS 完成] 安全通道已建立，准备发送加密免流头，目标地址: ${target}`);
    
    _writeHttpHeader();
    $session.httpStatus = HTTP_STATUS_CONNECTED;
    return true;
}

/**
 * 生命周期回调 3：收到代理服务器下发的数据
 */
function tunnelDidRead(data) {
    const target = `${$session.conHost}:${$session.conPort}`;
    
    // 状态 A：等待网关回应 200 OK
    if ($session.httpStatus === HTTP_STATUS_WAITRESPONSE) {
        console.log(`${LOG_PREFIX} ✔ [握手成功] 收到网关 200 OK 响应！目标: ${target}`);
        console.log(`${LOG_PREFIX} [通道建立] 正在调用 $tunnel.established() 并拦截网关响应头...`);
        
        $session.httpStatus = HTTP_STATUS_FORWARDING;
        $tunnel.established($session);
        
        // 返回 null 表示拦截/吞掉 HTTP 200 响应头，避免干扰 App
        return null;
    }
    
    // 状态 B：已进入透传阶段
    if ($session.httpStatus === HTTP_STATUS_FORWARDING) {
        // 数据量较大时可取消下方注释，避免日志刷屏
        // console.log(`${LOG_PREFIX} ⬇ [下行数据] 透传传输中 (${data ? data.byteLength || data.length : 0} bytes)`);
        return data;
    }
    
    // 兜底返回，防止丢包
    return data;
}

/**
 * 生命周期回调 4：向代理服务器写入数据完成
 */
function tunnelDidWrite() {
    const target = `${$session.conHost}:${$session.conPort}`;
    
    if ($session.httpStatus === HTTP_STATUS_CONNECTED) {
        console.log(`${LOG_PREFIX} ⬆ [请求头已发送] 等待代理网关回复响应头 (寻找 CRLF 结束符)... Target: ${target}`);
        $session.httpStatus = HTTP_STATUS_WAITRESPONSE;
        
        // 告诉 Loon 监听读取直到遇到 \r\n\r\n
        $tunnel.readTo($session, "\r\n\r\n");
        return false; // 挂起写回调，等待响应
    }
    
    return true;
}

/**
 * 生命周期回调 5：连接断开或关闭
 */
function tunnelDidClose() {
    const target = `${$session.conHost}:${$session.conPort}`;
    console.log(`${LOG_PREFIX} ✖ [连接断开/关闭] Session 已销毁，目标: ${target}`);
    
    $session.httpStatus = HTTP_STATUS_INVALID;
    return true;
}

// ==============================================================================
// 四、 核心伪装报头构造与写入 (结合详细报文日志)
// ==============================================================================

/**
 * 构造免流伪装请求头并发送
 */
function _writeHttpHeader() {
    const host = $session.conHost;
    const port = $session.conPort;
    const isUdp = $session.type === 1 || $session.isUdp === true;
    const isHg = isHongguoTarget(host);
    const doUdpMask = isUdpMasqueradeTarget(host, isUdp);

    let modeTitle = "普通 TCP 伪装";
    let header = "";

    // 分支 1：UDP 免流伪装
    if (doUdpMask) {
        modeTitle = "UDP/QUIC 特殊免流伪装";
        header = `CONNECT ${host}:${port} HTTP/1.1\r\n` +
                 `Host: 157.0.148.53:443\r\n` +
                 `Proxy-Connection: Keep-Alive\r\n` +
                 `Connection: keep-alive\r\n` +
                 `X-T5-Auth: 683556433\r\n` +
                 `User-Agent: baiduboxapp/8.0.0.0 (Linux; Android)\r\n` +
                 `X-Bd-Traceid: 0000000000000000000000000000000000000000\r\n` +
                 `X-Bd-Product: BDUSS\r\n` +
                 `X-Bd-Uid: 0\r\n` +
                 `X-Bd-Client-Type: UDP-TRANS\r\n` +
                 `X-Bd-Trans-Type: masquerade\r\n` +
                 `X-Bd-Request-Mode: tunnel\r\n` +
                 `Accept: */*\r\n` +
                 `Content-Length: 0\r\n\r\n`;
    } 
    // 分支 2：红果短剧/字节系 TCP 加强伪装
    else if (isHg) {
        modeTitle = "字节系/红果短剧 TCP 加强伪装";
        header = `CONNECT ${host}:${port} HTTP/1.1\r\n` +
                 `Host: 157.0.148.53:443\r\n` +
                 `Proxy-Connection: Keep-Alive\r\n` +
                 `Connection: keep-alive\r\n` +
                 `X-T5-Auth: 683556433\r\n` +
                 `User-Agent: baiduboxapp\r\n` +
                 `X-Bd-Traceid: 0000000000000000000000000000000000000000\r\n` +
                 `X-Bd-Product: BDUSS\r\n` +
                 `X-Bd-Uid: 0\r\n` +
                 `Accept: */*\r\n\r\n`;
    } 
    // 分支 3：普通 TCP 伪装
    else {
        modeTitle = "基础 TCP 伪装";
        header = `CONNECT ${host}:${port} HTTP/1.1\r\n` +
                 `Host: 157.0.148.53:443\r\n` +
                 `Proxy-Connection: Keep-Alive\r\n` +
                 `Connection: keep-alive\r\n` +
                 `X-T5-Auth: 683556433\r\n` +
                 `User-Agent: baiduboxapp\r\n\r\n`;
    }

    // 打印分支匹配结果日志
    console.log(`${LOG_PREFIX} ⚙ [匹配模式: ${modeTitle}] -> Host: ${host}:${port} | isHg: ${isHg} | isUdp: ${isUdp}`);
    
    // 打印最终写入的 Header 结构 (替换换行符方便在日志单行展示)
    console.log(`${LOG_PREFIX} 📝 [发送报文Preview]:\n${header.replace(/\r\n/g, " \\r\\n ")}`);

    // 写入请求头
    $tunnel.write($session, header);
}
